# VAD latency diagnostics.  Copy these values to the server container's
# environment only when detailed audio troubleshooting is needed.
#
# false: only transitions, gaps, ASR trigger/completion, and errors are logged.
# true: emits sampled [VAD_PACKET] and [VAD_BLOCK] records; never raw audio.
VAD_DEBUG_LOG=false

# Emit one detailed VAD block for every N 32-ms blocks when debug is enabled.
VAD_DEBUG_SAMPLE_EVERY_N_BLOCKS=1

# Warn if a voice turn remains active for this duration.
VAD_STUCK_VOICE_WARNING_MS=10000

# Warn if the receive-time gap between UDP packets exceeds this duration.
VAD_PACKET_GAP_WARNING_MS=150
