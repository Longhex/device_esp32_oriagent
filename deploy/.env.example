# Common
TZ=Asia/Saigon
MYSQL_DATABASE=xiaozhi_esp32_server
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
REDIS_PASSWORD=

# MCP Search Configuration (Avoid rate-limiting at scale)
# Example: http://username:password@proxy.example.com:8080
SEARCH_PROXY=

# Image tags
SERVER_IMAGE_NAME=xiaozhi-server-custom:local
WEB_IMAGE_NAME=xiaozhi-web-custom:local
MYSQL_IMAGE_TAG=latest
REDIS_IMAGE_TAG=8.0
EDGE_NGINX_TAG=1.27-alpine
NGINX_PROXY_TAG=1.7.0
ACME_COMPANION_TAG=2.6
EMQX_IMAGE_TAG=5.8

# EMQX — broker quản lý/giám sát thiết bị (độc lập với luồng audio)
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
EMQX_NODE_COOKIE=CHANGE_ME_TO_A_RANDOM_SECRET
# Cổng MQTT thiết bị (mở public). Dashboard chỉ bind localhost cho an toàn.
MQTT_TCP_PORT=1883
MQTT_SSL_PORT=8883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
EMQX_DASHBOARD_BIND=127.0.0.1
EMQX_DASHBOARD_PORT=18083

# device-monitor (consumer giám sát: nhận MQTT -> Redis -> HTTP API)
MONITOR_IMAGE_NAME=oriagent-device-monitor:local
MQTT_BACKEND_USER=oriagent-monitor
MQTT_BACKEND_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD
ENABLE_HK_LEGACY_BRIDGE=true
HK_MQTT_UPLINK_SUFFIX=AI_MONITOR
HK_MQTT_DOWNLINK_SUFFIX=AI_REMOTE
MONITOR_HTTP_BIND=127.0.0.1
MONITOR_HTTP_PORT=8090
# Endpoint MQTT public trả cho thiết bị khi activate (production: ${PUBLIC_DOMAIN}:1883)
MQTT_PUBLIC_ENDPOINT=broker.hkrobotics.ai:1883
# TEMPORARY single-firmware compatibility listener. Leave these blank in
# normal production. The broker still restricts publish/subscribe by client ID.
MQTT_ANONYMOUS_TEST_CLIENT_IDS=
MQTT_ANONYMOUS_TEST_PUBLIC_ENDPOINT=
MQTT_ANONYMOUS_TEST_BIND=127.0.0.1
MQTT_ANONYMOUS_TEST_PORT=1884
PUBLIC_UDP_HOST=device.oriagent.com
VOICE_UDP_PORT=8883

# OTA provisioning boundary. Today this is device-monitor; later point it to
# the dedicated serial-validation/provisioning service.
DEVICE_PROVISIONER_API=http://device-monitor:8090
# Temporary onboarding only: on /activate 403, declare the OTA serial then retry.
# This weakens the serial allow-list. Keep false in normal production operation.
AUTO_DECLARE_OTA_SERIAL=false

# Production domain + Let's Encrypt
PUBLIC_DOMAIN=device.oriagent.com
PUBLIC_WEBSOCKET_URL=wss://device.oriagent.com/xiaozhi/v1/
LETSENCRYPT_EMAIL=gamo100@proton.me
HTTP_PORT=80
HTTPS_PORT=443

# Local / no-domain test
TEST_HTTP_BIND=127.0.0.1
TEST_HTTP_PORT=8080

# Reverse proxy behavior
CLIENT_MAX_BODY_SIZE=100m
PROXY_READ_TIMEOUT=300s

# Device voice transport: MQTT signaling + UDP AES-CTR; no device WebSocket.
TRANSPORT_MODE=mqtt_udp_hk
FIRMWARE_TRANSPORT_POLICY=mqtt_only

# Resource limits
SERVER_CPU_LIMIT=1.2
SERVER_MEMORY_LIMIT=2500m
WEB_CPU_LIMIT=0.4
WEB_MEMORY_LIMIT=700m
MYSQL_CPU_LIMIT=0.2
MYSQL_MEMORY_LIMIT=400m
REDIS_CPU_LIMIT=0.1
REDIS_MEMORY_LIMIT=100m
EDGE_CPU_LIMIT=0.2
EDGE_MEMORY_LIMIT=128m
EMQX_CPU_LIMIT=0.5
EMQX_MEMORY_LIMIT=512m
MONITOR_CPU_LIMIT=0.3
MONITOR_MEMORY_LIMIT=200m
