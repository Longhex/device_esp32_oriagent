# Preserve the public scheme/host from the outer TLS proxy. Direct HTTP access
# falls back to the values seen by this edge router.
map $http_x_forwarded_proto $proxy_forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

map $http_x_forwarded_host $proxy_forwarded_host {
    default $http_x_forwarded_host;
    '' $http_host;
}

server {
    listen 80;
    server_name _;
    resolver 127.0.0.11 ipv6=off valid=30s;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    proxy_http_version 1.1;
    proxy_connect_timeout 30s;
    proxy_read_timeout ${PROXY_READ_TIMEOUT};
    proxy_send_timeout ${PROXY_READ_TIMEOUT};

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location /xiaozhi/v1/ {
        if ("${FIRMWARE_TRANSPORT_POLICY}" = "mqtt_only") {
            default_type application/json;
            return 410 '{"type":"error","code":"websocket_voice_disabled","transport":"mqtt_udp"}';
        }

        set $ws_upstream http://xiaozhi-esp32-server:8000;
        proxy_pass $ws_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $proxy_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_forwarded_proto;
        proxy_read_timeout 3600s;
    }

    # OTA URL thiếu dấu '/' cuối: ESP32 không follow 301 -> rewrite nội bộ (không trả 301 cho thiết bị)
    location = /xiaozhi/ota {
        rewrite ^ /xiaozhi/ota/ last;
    }

    location /xiaozhi/ota/ {
        set $http_upstream http://xiaozhi-esp32-server:8003;
        proxy_pass $http_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $proxy_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_forwarded_proto;
    }

    location /images/ {
        set $http_upstream http://xiaozhi-esp32-server:8003;
        proxy_pass $http_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Cache ảnh tĩnh ở Nginx level (giảm tải cho Python server)
        proxy_cache_valid 200 1h;
        expires 1h;
    }

    location /mcp/ {
        set $http_upstream http://xiaozhi-esp32-server:8003;
        proxy_pass $http_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $web_upstream http://xiaozhi-esp32-server-web:8002;
        proxy_pass $web_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
